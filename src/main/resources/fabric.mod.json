{
  "schemaVersion": 1,
  "id": "invmod",
  "version": "${version}",
  "name": "Invasion (Fabric Fork)",
  "description": "Fork der klassischen Invasion-Mod, aktualisiert und erweitert für moderne Minecraft-Versionen von Cedric.",
  "authors": [
    "Cedric",
    "Lieu (Originalautor)",
    "Elsee",
    "Davidee",
    "UnstoppableN",
    "Doenerstyle",
    "Sollace"
  ],
  "contact": {
    "sources": "https://github.com/Sollace/Invasion-Mod",
    "issues": "https://github.com/Sollace/Invasion-Mod/issues"
  },
  "license": "MIT",
  "icon": "assets/invmod/meta/logo.png",
  "accessWidener": "invasion.aw",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.invasion.InvasionMod"
    ],
    "client": [
      "com.invasion.client.InvasionModClient"
    ],
    "jei_mod_plugin": [
      "com.invasion.compat.jei.InvasionJeiPlugin"
    ]
  },
  "mixins": [
    "invasion.mixin.json"
  ],
  "depends": {
    "minecraft": "${minecraftVersion}",
    "fabricloader": "${loaderVersion}",
    "java": ">=25",
    "fabric-api": "${fabricVersion}"
  },
  "suggests": {
    "modmenu": "*",
    "jei": "*"
  }
}
